{
  "name": "kyouyou",
  "version": "0.3.0",
  "description": "Code shared by the Kōkūzu, Kōro and Kansei flight-simulation apps",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./gfs/fields": {
      "types": "./dist/gfs/fields.d.ts",
      "default": "./dist/gfs/fields.js"
    },
    "./gfs/grib2": {
      "types": "./dist/gfs/grib2.d.ts",
      "default": "./dist/gfs/grib2.js"
    },
    "./gfs/noaa-index": {
      "types": "./dist/gfs/noaa-index.d.ts",
      "default": "./dist/gfs/noaa-index.js"
    },
    "./gfs/fake-gfs": {
      "types": "./dist/gfs/fake-gfs.d.ts",
      "default": "./dist/gfs/fake-gfs.js"
    },
    "./atmosphere": {
      "types": "./dist/atmosphere/atmosphere.d.ts",
      "default": "./dist/atmosphere/atmosphere.js"
    },
    "./geo": {
      "types": "./dist/geo/geo.d.ts",
      "default": "./dist/geo/geo.js"
    },
    "./geo/track": {
      "types": "./dist/geo/track.d.ts",
      "default": "./dist/geo/track.js"
    },
    "./geo/polygon": {
      "types": "./dist/geo/polygon.d.ts",
      "default": "./dist/geo/polygon.js"
    },
    "./geo/magnetic": {
      "types": "./dist/geo/magnetic.d.ts",
      "default": "./dist/geo/magnetic.js"
    },
    "./fms": {
      "types": "./dist/fms/fms.d.ts",
      "default": "./dist/fms/fms.js"
    },
    "./xplane/read": {
      "types": "./dist/xplane/read.d.ts",
      "default": "./dist/xplane/read.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "5.0.3"
  }
}
